# Copia este archivo a ".env" y ajusta valores (nunca subas .env al repositorio).

# --- PostgreSQL (servicio `db` en Docker) ---
POSTGRES_DB=opscenter
POSTGRES_USER=opscenter
# En producción usa una contraseña fuerte y distinta.
POSTGRES_PASSWORD=change_me_strong_password

# URL que usa SQLAlchemy (backend). En Docker el host es `db`.
DATABASE_URL=postgresql://opscenter:change_me_strong_password@db:5432/opscenter

# --- JWT (obligatorio; sin esto el backend no arranca) ---
# Genera una cadena larga y aleatoria (p. ej. openssl rand -hex 32).
SECRET_KEY=change_me_run_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS: orígenes del navegador permitidos (separados por coma, sin espacios extra) ---
# Incluye la URL desde la que abres Streamlit. Con Docker suele ser localhost:8501.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Frontend (Streamlit fuera de Docker / pruebas locales) ---
# En Docker Compose se sobrescribe a http://backend:8000 automáticamente.
API_BASE_URL=http://localhost:8000